{
  "name": "staedel-mcp",
  "version": "1.0.0",
  "description": "MCP server exposing the Städel Museum's digital collection (OAI-PMH/LIDO) to AI assistants — search, retrieve metadata, and browse artworks with an interactive UI.",
  "main": "dist/index.js",
  "bin": {
    "staedel-mcp": "dist/index.js"
  },
  "type": "module",
  "files": [
    "dist",
    "manifest.json",
    "readme.md"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "check": "tsc --noEmit",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "staedel-museum",
    "oai-pmh",
    "lido",
    "museum",
    "digital-collection",
    "art"
  ],
  "author": "Christian Block (topoftheblock)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/topoftheblock/staedel-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/topoftheblock/staedel-mcp/issues"
  },
  "homepage": "https://github.com/topoftheblock/staedel-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^4.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.2"
  }
}
